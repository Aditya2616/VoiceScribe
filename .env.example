# Extractor: rules | local | openai | anthropic   (default: rules)
VOICESCRIBE_EXTRACTOR=rules
# Whisper model: tiny.en | base.en | small.en
VOICESCRIBE_WHISPER=base.en
# Local verifier model (only for VOICESCRIBE_EXTRACTOR=local)
VOICESCRIBE_LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Hosted adapters (optional; never commit real keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=test-model
# Max threads for Whisper / torch (default: a quarter of the cores)
VOICESCRIBE_THREADS=3
